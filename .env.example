# Fill in ONE option. Never commit .env.

# Option A: Amazon Bedrock API key (Bedrock console -> API keys; starts with ABSK or bedrock-api-key-)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Option B: Claude Platform on AWS key (starts with aws-external-anthropic-api-key-)
# Billed via AWS Marketplace. Needs your Claude workspace ID too.
# ANTHROPIC_AWS_API_KEY=
# ANTHROPIC_AWS_WORKSPACE_ID=

# Option C: standard AWS credentials for Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
